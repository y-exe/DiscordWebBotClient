{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "build:next": {
      "dependsOn": ["^build:next"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "test:security": {
      "cache": false
    },
    "lint": {
      "outputs": []
    }
  }
}
