{
  "name": "discord-web-bot-client",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build:next",
    "test": "turbo run test:security",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run lint && bun run test",
    "lint:react": "turbo run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "postcss-selector-parser": "^7.1.6",
    "next": "16.3.8"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
